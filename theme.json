        "typography": {
            "customFontSize": true,
            "dropCap": true,
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
                    "slug": "awx-heading",
                    "name": "Heading"
                },
                {
                    "fontFamily": "'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif",
                    "slug": "awx-body",
                    "name": "Body"
                },
                {
                    "fontFamily": "'JetBrains Mono', 'Fira Code', ui-monospace, 'Cascadia Code', 'Source Code Pro', monospace",
                    "slug": "awx-mono",
                    "name": "Monospace"
                }
            ],
            "fontSizes": [
                {
                    "slug": "awx--2",
                    "size": "0.64rem",
                    "name": "Fine Print",
                    "fluid": false
                },
                {
                    "slug": "awx--1",
                    "size": "0.8rem",
                    "name": "Caption",
                    "fluid": false
                },
                {
                    "slug": "awx-0",
                    "size": "1rem",
                    "name": "Body",
                    "fluid": false
                },
                {
                    "slug": "awx-1",
                    "size": "1.25rem",
                    "name": "Lead",
                    "fluid": {
                        "min": "1.1rem",
                        "max": "1.25rem"
                    }
                },
                {
                    "slug": "awx-2",
                    "size": "1.563rem",
                    "name": "H6 / H5",
                    "fluid": {
                        "min": "1.25rem",
                        "max": "1.563rem"
                    }
                },
                {
                    "slug": "awx-3",
                    "size": "1.953rem",
                    "name": "H4",
                    "fluid": {
                        "min": "1.5rem",
                        "max": "1.953rem"
                    }
                },
                {
                    "slug": "awx-4",
                    "size": "2.441rem",
                    "name": "H3",
                    "fluid": {
                        "min": "1.75rem",
                        "max": "2.441rem"
                    }
                },
                {
                    "slug": "awx-5",
                    "size": "3.052rem",
                    "name": "H2",
                    "fluid": {
                        "min": "2rem",
                        "max": "3.052rem"
                    }
                },
                {
                    "slug": "awx-6",
                    "size": "3.815rem",
                    "name": "H1",
                    "fluid": {
                        "min": "2.25rem",
                        "max": "3.815rem"
                    }
                },
                {
                    "slug": "awx-7",
                    "size": "4.768rem",
                    "name": "Display",
                    "fluid": {
                        "min": "2.5rem",
                        "max": "4.768rem"
                    }
                },
                {
                    "slug": "awx-8",
                    "size": "5.96rem",
                    "name": "Display XL",
                    "fluid": {
                        "min": "2.75rem",
                        "max": "5.96rem"
                    }
                }
            ],
            "lineHeight": true,
            "textDecoration": true,
            "textTransform": true,
            "letterSpacing": true,
            "writingMode": true
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                {
                    "name": "Subtle",
                    "slug": "awx-1",
                    "shadow": "0 1px 2px 0 rgb(0 0 0 / 0.05)"
                },
                {
                    "name": "Raised",
                    "slug": "awx-2",
                    "shadow": "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)"
                },
                {
                    "name": "Elevated",
                    "slug": "awx-3",
                    "shadow": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)"
                },
                {
                    "name": "Floating",
                    "slug": "awx-4",
                    "shadow": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
                },
                {
                    "name": "High",
                    "slug": "awx-5",
                    "shadow": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)"
                }
            ]
        },
        "custom": {
            "fontWeight": {
                "light": 300,
                "regular": 400,
                "medium": 500,
                "semibold": 600,
                "bold": 700
            },
            "lineHeight": {
                "none": 1,
                "tight": 1.2,
                "snug": 1.35,
                "normal": 1.5,
                "relaxed": 1.65,
                "loose": 1.8
            },
            "letterSpacing": {
                "tighter": "-0.04em",
                "tight": "-0.02em",
                "normal": "0em",
                "wide": "0.025em",
                "wider": "0.05em",
                "widest": "0.1em"
            },
            "radius": {
                "none": "0",
                "sm": "4px",
                "md": "8px",
                "lg": "12px",
                "xl": "16px",
                "2xl": "24px",
                "full": "9999px"
            },
            "borderWidth": {
                "thin": "1px",
                "default": "1.5px",
                "thick": "2px"
            },
            "duration": {
                "fast": "120ms",
                "normal": "200ms",
                "slow": "320ms"
            },
            "ease": {
                "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
                "emphasized": "cubic-bezier(0.2, 0, 0, 1)"
            },
            "zIndex": {
                "deep": -1,
                "base": 0,
                "raised": 1,
                "dropdown": 10,
                "sticky": 20,
                "overlay": 30,
                "modal": 40,
                "toast": 50
            },
            "measure": {
                "default": "65ch",
                "wide": "80ch",
                "narrow": "45ch"
            }
        },
        "blocks": {
            "core/button": {
                "border": {
                    "radius": true
                }
            },
            "core/pullquote": {
                "border": {
                    "color": true,
                    "radius": true,
                    "style": true,
                    "width": true
                }
            },
            "core/navigation": {
                "typography": {
                    "fontSizes": true,
                    "customFontSize": true
                }
            }
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--awx-background)",
            "text": "var(--wp--preset--color--awx-text)"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--awx-2)",
            "padding": {
                "top": "0",
                "right": "var(--wp--preset--spacing--awx-3)",
                "bottom": "0",
                "left": "var(--wp--preset--spacing--awx-3)"
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--awx-body)",
            "fontSize": "var(--wp--preset--font-size--awx-0)",
            "lineHeight": "var(--wp--custom--line-height--normal)"
        },
        "elements": {
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--awx-primary)",
                    "text": "var(--wp--preset--color--awx-on-primary)"
                },
                "border": {
                    "radius": "var(--wp--custom--radius--sm)"
                },
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--awx-1)",
                        "right": "var(--wp--preset--spacing--awx-4)",
                        "bottom": "var(--wp--preset--spacing--awx-1)",
                        "left": "var(--wp--preset--spacing--awx-4)"
                    }
                },
                "typography": {
                    "fontWeight": "var(--wp--custom--font-weight--semibold)",
                    "fontSize": "var(--wp--preset--font-size--awx-0)"
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--awx-primary-dark)"
                    }
                },
                ":focus": {
                    "color": {
                        "background": "var(--wp--preset--color--awx-primary-dark)"
                    },
                    "outline": {
                        "offset": "2px",
                        "style": "solid",
                        "width": "2px",
                        "color": "var(--wp--preset--color--awx-focus-ring)"
                    }
                }
            },
            "h1": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--awx-heading)",
                    "fontSize": "var(--wp--preset--font-size--awx-6)",
                    "lineHeight": "var(--wp--custom--line-height--tight)",
                    "fontWeight": "var(--wp--custom--font-weight--bold)",
                    "letterSpacing": "var(--wp--custom--letter-spacing--tighter)"
                },
                "color": {
                    "text": "var(--wp--preset--color--awx-text)"
                },
                "spacing": {
                    "margin": {
                        "top": "0",
                        "bottom": "var(--wp--preset--spacing--awx-3)"
                    }
                }
            },
            "h2": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--awx-heading)",
                    "fontSize": "var(--wp--preset--font-size--awx-5)",
                    "lineHeight": "var(--wp--custom--line-height--tight)",
                    "fontWeight": "var(--wp--custom--font-weight--bold)",
                    "letterSpacing": "var(--wp--custom--letter-spacing--tight)"
                },
                "color": {
                    "text": "var(--wp--preset--color--awx-text)"
                },
                "spacing": {
                    "margin": {
                        "top": "var(--wp--preset--spacing--awx-6)",
                        "bottom": "var(--wp--preset--spacing--awx-2)"
                    }
                }
            },
            "h3": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--awx-heading)",
                    "fontSize": "var(--wp--preset--font-size--awx-4)",
                    "lineHeight": "var(--wp--custom--line-height--snug)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)",
                    "letterSpacing": "var(--wp--custom--letter-spacing--tight)"
                },
                "color": {
                    "text": "var(--wp--preset--color--awx-text)"
                },
                "spacing": {
                    "margin": {
                        "top": "var(--wp--preset--spacing--awx-5)",
                        "bottom": "var(--wp--preset--spacing--awx-15)"
                    }
                }
            },
            "h4": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--awx-heading)",
                    "fontSize": "var(--wp--preset--font-size--awx-3)",
                    "lineHeight": "var(--wp--custom--line-height--snug)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)"
                },
                "color": {
                    "text": "var(--wp--preset--color--awx-text)"
                }
            },
            "h5": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--awx-heading)",
                    "fontSize": "var(--wp--preset--font-size--awx-2)",
                    "lineHeight": "var(--wp--custom--line-height--snug)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)"
                },
                "color": {
                    "text": "var(--wp--preset--color--awx-text)"
                }
            },
            "h6": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--awx-heading)",
                    "fontSize": "var(--wp--preset--font-size--awx-1)",
                    "lineHeight": "var(--wp--custom--line-height--normal)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)",
                    "textTransform": "uppercase",
                    "letterSpacing": "var(--wp--custom--letter-spacing--wide)"
                },
                "color": {
                    "text": "var(--wp--preset--color--awx-text-secondary)"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--awx-text)"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--awx-link)"
                },
                "typography": {
                    "textDecoration": "underline"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--awx-link-hover)"
                    }
                },
                ":focus": {
                    "color": {
                        "text": "var(--wp--preset--color--awx-link-hover)"
                    },
                    "outline": {
                        "offset": "2px"
                    }
                }
            },
            "caption": {
                "color": {
                    "text": "var(--wp--preset--color--awx-text-muted)"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--awx--1)"
                }
            },
            "cite": {
                "typography": {
                    "fontStyle": "italic"
                },
                "color": {
                    "text": "var(--wp--preset--color--awx-text-muted)"
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--awx-2)",
                    "fontWeight": "var(--wp--custom--font-weight--bold)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--awx-text)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--awx-primary)"
                            }
                        }
                    }
                }
            },
            "core/navigation": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--awx-0)"
                },
                "elements": {
                    "link": {
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                }
            },
            "core/post-title": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--awx-text)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--awx-primary)"
                            }
                        }
                    }
                }
            },
            "core/post-date": {
                "color": {
                    "text": "var(--wp--preset--color--awx-text-muted)"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--awx--1)"
                }
            },
            "core/post-author": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--awx--1)"
                }
            },
            "core/post-terms": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--awx--1)"
                }
            },
            "core/quote": {
                "border": {
                    "left": {
                        "color": "var(--wp--preset--color--awx-primary)",
                        "style": "solid",
                        "width": "4px"
                    }
                },
                "spacing": {
                    "padding": {
                        "left": "var(--wp--preset--spacing--awx-3)"
                    }
