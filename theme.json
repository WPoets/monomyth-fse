{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "useRootPaddingAwareAlignments": true,
        "layout": {
            "contentSize": "720px",
            "wideSize": "1200px"
        },
        "color": {
            "custom": true,
            "customDuotone": true,
            "customGradient": true,
            "defaultDuotone": true,
            "defaultGradients": true,
            "defaultPalette": false,
            "duotone": [],
            "gradients": [
                {
                    "slug": "primary-to-secondary",
                    "gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--secondary) 100%)",
                    "name": "Primary to Secondary"
                },
                {
                    "slug": "light-to-dark",
                    "gradient": "linear-gradient(180deg, var(--wp--preset--color--base) 0%, var(--wp--preset--color--contrast) 100%)",
                    "name": "Light to Dark"
                }
            ],
            "palette": [
                {
                    "slug": "base",
                    "color": "#ffffff",
                    "name": "Base"
                },
                {
                    "slug": "contrast",
                    "color": "#1e1e1e",
                    "name": "Contrast"
                },
                {
                    "slug": "primary",
                    "color": "#0073aa",
                    "name": "Primary"
                },
                {
                    "slug": "secondary",
                    "color": "#23282d",
                    "name": "Secondary"
                },
                {
                    "slug": "accent",
                    "color": "#00a0d2",
                    "name": "Accent"
                },
                {
                    "slug": "neutral",
                    "color": "#757575",
                    "name": "Neutral"
                },
                {
                    "slug": "neutral-light",
                    "color": "#f0f0f0",
                    "name": "Neutral Light"
                }
            ]
        },
        "spacing": {
            "customSpacingSize": true,
            "spacingScale": {
                "steps": 0
            },
            "spacingSizes": [
                {
                    "slug": "10",
                    "size": "0.25rem",
                    "name": "1"
                },
                {
                    "slug": "20",
                    "size": "0.5rem",
                    "name": "2"
                },
                {
                    "slug": "30",
                    "size": "1rem",
                    "name": "3"
                },
                {
                    "slug": "40",
                    "size": "1.5rem",
                    "name": "4"
                },
                {
                    "slug": "50",
                    "size": "2rem",
                    "name": "5"
                },
                {
                    "slug": "60",
                    "size": "3rem",
                    "name": "6"
                },
                {
                    "slug": "70",
                    "size": "4rem",
                    "name": "7"
                },
                {
                    "slug": "80",
                    "size": "6rem",
                    "name": "8"
                }
            ],
            "units": [
                "%",
                "px",
                "em",
                "rem",
                "vh",
                "vw"
            ]
        },
        "typography": {
            "customFontSize": true,
            "dropCap": true,
            "fluid": true,
            "fontFamilies": [
                {
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
                    "slug": "system-sans",
                    "name": "System Sans-serif"
                },
                {
                    "fontFamily": "Georgia, 'Times New Roman', Times, serif",
                    "slug": "system-serif",
                    "name": "System Serif"
                },
                {
                    "fontFamily": "Menlo, Consolas, Monaco, 'Liberation Mono', 'Lucida Console', monospace",
                    "slug": "system-mono",
                    "name": "System Monospace"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "size": "0.875rem",
                    "name": "Small",
                    "fluid": {
                        "min": "0.75rem",
                        "max": "0.875rem"
                    }
                },
                {
                    "slug": "medium",
                    "size": "1rem",
                    "name": "Medium",
                    "fluid": {
                        "min": "0.875rem",
                        "max": "1rem"
                    }
                },
                {
                    "slug": "large",
                    "size": "1.25rem",
                    "name": "Large",
                    "fluid": {
                        "min": "1rem",
                        "max": "1.25rem"
                    }
                },
                {
                    "slug": "x-large",
                    "size": "1.5rem",
                    "name": "Extra Large",
                    "fluid": {
                        "min": "1.25rem",
                        "max": "1.5rem"
                    }
                },
                {
                    "slug": "xx-large",
                    "size": "2.25rem",
                    "name": "Huge",
                    "fluid": {
                        "min": "1.75rem",
                        "max": "2.25rem"
                    }
                }
            ],
            "lineHeight": true,
            "textDecoration": true,
            "textTransform": true,
            "letterSpacing": true,
            "writingMode": true
        },
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "shadow": {
            "defaultPresets": true,
            "presets": [
                {
                    "name": "Small",
                    "slug": "sm",
                    "shadow": "0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)"
                },
                {
                    "name": "Medium",
                    "slug": "md",
                    "shadow": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)"
                },
                {
                    "name": "Large",
                    "slug": "lg",
                    "shadow": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1)"
                },
                {
                    "name": "Extra Large",
                    "slug": "xl",
                    "shadow": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1)"
                }
            ]
        },
        "custom": {
            "spacing": {
                "small": "1rem",
                "medium": "2rem",
                "large": "4rem"
            },
            "lineHeight": {
                "body": 1.6,
                "heading": 1.3
            },
            "fontWeight": {
                "light": 300,
                "normal": 400,
                "medium": 500,
                "semibold": 600,
                "bold": 700
            }
        },
        "blocks": {
            "core/button": {
                "border": {
                    "radius": true
                }
            },
            "core/pullquote": {
                "border": {
                    "color": true,
                    "radius": true,
                    "style": true,
                    "width": true
                }
            },
            "core/navigation": {
                "typography": {
                    "fontSizes": true,
                    "customFontSize": true
                }
            }
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
        },
        "spacing": {
            "blockGap": "var(--wp--preset--spacing--30)",
            "padding": {
                "top": "0",
                "right": "var(--wp--preset--spacing--30)",
                "bottom": "0",
                "left": "var(--wp--preset--spacing--30)"
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system-sans)",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "var(--wp--custom--line-height--body)"
        },
        "elements": {
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--primary)",
                    "text": "var(--wp--preset--color--base)"
                },
                "border": {
                    "radius": "4px"
                },
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--20)",
                        "right": "var(--wp--preset--spacing--40)",
                        "bottom": "var(--wp--preset--spacing--20)",
                        "left": "var(--wp--preset--spacing--40)"
                    }
                },
                "typography": {
                    "fontWeight": "var(--wp--custom--font-weight--semibold)"
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--accent)"
                    }
                },
                ":focus": {
                    "color": {
                        "background": "var(--wp--preset--color--accent)"
                    },
                    "outline": {
                        "offset": "2px",
                        "style": "solid",
                        "width": "2px"
                    }
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "clamp(2rem, 5vw, 3rem)",
                    "lineHeight": "var(--wp--custom--line-height--heading)",
                    "fontWeight": "var(--wp--custom--font-weight--bold)"
                },
                "spacing": {
                    "margin": {
                        "top": "0",
                        "bottom": "var(--wp--preset--spacing--40)"
                    }
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "clamp(1.5rem, 4vw, 2.25rem)",
                    "lineHeight": "var(--wp--custom--line-height--heading)",
                    "fontWeight": "var(--wp--custom--font-weight--bold)"
                },
                "spacing": {
                    "margin": {
                        "top": "var(--wp--preset--spacing--50)",
                        "bottom": "var(--wp--preset--spacing--30)"
                    }
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "clamp(1.25rem, 3vw, 1.75rem)",
                    "lineHeight": "var(--wp--custom--line-height--heading)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)"
                },
                "spacing": {
                    "margin": {
                        "top": "var(--wp--preset--spacing--40)",
                        "bottom": "var(--wp--preset--spacing--20)"
                    }
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "clamp(1.1rem, 2vw, 1.5rem)",
                    "lineHeight": "var(--wp--custom--line-height--heading)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)",
                    "lineHeight": "var(--wp--custom--line-height--heading)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)",
                    "lineHeight": "var(--wp--custom--line-height--heading)",
                    "fontWeight": "var(--wp--custom--font-weight--semibold)",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.05em"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--wp--preset--color--contrast)"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--primary)"
                },
                "typography": {
                    "textDecoration": "underline"
                },
                ":hover": {
                    "color": {
                        "text": "var(--wp--preset--color--accent)"
                    }
                },
                ":focus": {
                    "color": {
                        "text": "var(--wp--preset--color--accent)"
                    },
                    "outline": {
                        "offset": "2px"
                    }
                }
            },
            "caption": {
                "color": {
                    "text": "var(--wp--preset--color--neutral)"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            },
            "cite": {
                "typography": {
                    "fontStyle": "italic"
                }
            }
        },
        "blocks": {
            "core/site-title": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "var(--wp--custom--font-weight--bold)"
                },
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--contrast)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--primary)"
                            }
                        }
                    }
                }
            },
            "core/navigation": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)"
                },
                "elements": {
                    "link": {
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "typography": {
                                "textDecoration": "underline"
                            }
                        }
                    }
                }
            },
            "core/post-title": {
                "elements": {
                    "link": {
                        "color": {
                            "text": "var(--wp--preset--color--contrast)"
                        },
                        "typography": {
                            "textDecoration": "none"
                        },
                        ":hover": {
                            "color": {
                                "text": "var(--wp--preset--color--primary)"
                            }
                        }
                    }
                }
            },
            "core/post-date": {
                "color": {
                    "text": "var(--wp--preset--color--neutral)"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            },
            "core/post-author": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            },
            "core/post-terms": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            },
            "core/quote": {
                "border": {
                    "left": {
                        "color": "var(--wp--preset--color--primary)",
                        "style": "solid",
                        "width": "4px"
                    }
                },
                "spacing": {
                    "padding": {
                        "left": "var(--wp--preset--spacing--40)"
                    }
                },
                "typography": {
                    "fontStyle": "italic"
                }
            },
            "core/pullquote": {
                "border": {
                    "top": {
                        "color": "var(--wp--preset--color--primary)",
                        "style": "solid",
                        "width": "4px"
                    },
                    "bottom": {
                        "color": "var(--wp--preset--color--primary)",
                        "style": "solid",
                        "width": "4px"
                    }
                },
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--40)",
                        "bottom": "var(--wp--preset--spacing--40)"
                    }
                }
            },
            "core/code": {
                "color": {
                    "background": "var(--wp--preset--color--neutral-light)",
                    "text": "var(--wp--preset--color--contrast)"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--system-mono)",
                    "fontSize": "var(--wp--preset--font-size--small)"
                },
                "spacing": {
                    "padding": {
                        "top": "var(--wp--preset--spacing--30)",
                        "right": "var(--wp--preset--spacing--30)",
                        "bottom": "var(--wp--preset--spacing--30)",
                        "left": "var(--wp--preset--spacing--30)"
                    }
                },
                "border": {
                    "radius": "4px"
                }
            },
            "core/preformatted": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--system-mono)",
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            },
            "core/separator": {
                "color": {
                    "text": "var(--wp--preset--color--neutral-light)"
                },
                "border": {
                    "color": "currentColor",
                    "style": "solid",
                    "width": "0 0 1px 0"
                }
            },
            "core/table": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            }
        }
    },
    "templateParts": [
        {
            "name": "header",
            "title": "Header (Awesome Enterprise)",
            "area": "header"
        },
        {
            "name": "header-fallback",
            "title": "Header (Standard)",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer (Awesome Enterprise)",
            "area": "footer"
        },
        {
            "name": "footer-fallback",
            "title": "Footer (Standard)",
            "area": "footer"
        },
        {
            "name": "sidebar",
            "title": "Sidebar (Awesome Enterprise)",
            "area": "uncategorized"
        },
        {
            "name": "sidebar-fallback",
            "title": "Sidebar (Standard)",
            "area": "uncategorized"
        }
    ],
    "customTemplates": [
        {
            "name": "blank",
            "title": "Blank",
            "postTypes": ["page", "post"]
        },
        {
            "name": "page-no-title",
            "title": "Page (No Title)",
            "postTypes": ["page"]
        }
    ]
}
